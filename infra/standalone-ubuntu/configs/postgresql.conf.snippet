# ==============================================================================
# EMS Platform: PostgreSQL 16 Performance & Security Configuration Snippet
# Recommended path on Ubuntu 24.04: /etc/postgresql/16/main/conf.d/99-ems.conf
# ==============================================================================

# Network & Connectivity
listen_addresses = '127.0.0.1,::1'
port = 5432
max_connections = 100

# Authentication & Password Security
password_encryption = scram-sha-256

# Memory Configuration (Tuned for Stand / Acceptance)
shared_buffers = 1GB
work_mem = 16MB
maintenance_work_mem = 128MB
effective_cache_size = 3GB

# Timeouts & Lock Contention Controls (Mitigation for hanging locks)
statement_timeout = 60000                     # 60s max per statement
lock_timeout = 10000                          # 10s max waiting on a lock
idle_in_transaction_session_timeout = 30000   # 30s max idle in transaction

# Logging & Audit (Security & Diagnostics)
log_destination = 'stderr'
logging_collector = on
log_directory = 'log'
log_filename = 'postgresql-%Y-%m-%d_%H%M%S.log'
log_min_messages = warning
log_min_error_statement = error
log_line_prefix = '%m [%p] %q%u@%d '
log_timezone = 'UTC'
timezone = 'UTC'
