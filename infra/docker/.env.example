# ==============================================================================
# EMS Platform: Local Development & Debug Stand Environment Variables
# ==============================================================================

# --- PostgreSQL 16 Settings ---
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_master_secret
EMS_MIGRATION_USER=ems_migration
EMS_MIGRATION_PASSWORD=migration_secret
EMS_RUNTIME_USER=ems_runtime
EMS_RUNTIME_PASSWORD=runtime_secret
EMS_DEV_DB=ems_dev
EMS_TEST_DB=ems_test

# --- Samba 4 Active Directory DC Settings ---
SAMBA_REALM=CORP.LOCAL
SAMBA_DOMAIN=CORP
SAMBA_ADMIN_PASSWORD=Admin_Secret_Pass123!
SAMBA_LDAP_PORT=389
SAMBA_LDAPS_PORT=636

# --- Nginx Ingress Settings ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Acceptance Test Connection Strings ---
EMS_TEST_PG_INTEGRATION=true
EMS_TEST_PG_MIGRATION_URL=postgresql://ems_migration:migration_secret@localhost:5432/ems_test
EMS_TEST_PG_RUNTIME_URL=postgresql://ems_runtime:runtime_secret@localhost:5432/ems_test
